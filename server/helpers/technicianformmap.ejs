<%- include("partials/header.ejs") %>

<!-- Bootstrap Icons -->
<link rel="stylesheet"
 href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">



<% if (locals.submitbutton) { %> 
<div class="alert alert-warning alert-dismissible show" role="alert">
  <%= message %>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div> 
<% } %>      

<div class="container my-5 px-2 d-flex justify-content-center align-items-center min-vh-100">

<% if (!locals.submitbutton) { %>

<div class="card shadow-lg rounded-4 p-4 border-0 w-100"
     style="max-width: 800px; background-color: #fefdf9;">

<form class="row g-4" action="/technician" method="POST">

  <!-- PROFILE -->
  <div class="text-center mb-4">
    <h3 class="fw-bold">
      <i class="bi bi-person-badge"></i>
      Προσθήκη Τεχνίτη
    </h3>
    <p class="text-muted">Συμπληρώστε τα στοιχεία για νέο τεχνίτη. Δωρεάν Καταχώρηση!</p>
  </div>

  <div class="mb-3">
    <label class="form-label">Όνομα</label>
    <input type="text" class="form-control rounded-pill"
           name="Onoma" required>
  </div>

  <div class="mb-4">
    <label class="form-label">Επίθετο</label>
    <input type="text" class="form-control rounded-pill"
           name="Epitheto" required>
  </div>

  <hr class="my-4">

  <!-- SERVICE CARDS -->
  <div id="servicesContainer"></div>

  <!-- ACTION BAR -->
  <div class="text-center mt-4">
    <button type="button"
            class="btn btn-success rounded-pill px-4 shadow-sm me-3"
            onclick="addServiceCard()">
      <i class="bi bi-plus-circle"></i>
      Προσθήκη Πόλης
    </button>

    <button type="button"
            class="btn btn-outline-danger rounded-pill px-4 shadow-sm"
            onclick="removeLastServiceCard()">
      <i class="bi bi-trash"></i>
      Διαγραφή Πόλης
    </button>
  </div>

  <button type="submit"
          class="btn btn-success w-100 rounded-pill py-2 mt-4 shadow">
    Υποβολή Τεχνίτη
  </button>

</form>
</div>
<% } %>
</div>

<%- include("partials/footer.ejs") %>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


<script>
let serviceIndex = 0;

const optionsMap = {
  "Καθαρισμός": ["Κοινόχρηστοι Χώροι","Διαμερισμάτων","Οικιακές Εργασίες","Τύπου Airbnb","Άλλο"],
  "Μετακομίσεις-Μεταφορές": ["Εντός Πόλεως","Εκτός Πόλεως","Ανυψωτικό"],
  "Οικιακές Συσκευές": ["Λευκές Οικιακές Συσκευές","Όλων των Ειδών"],
  "Υδραυλικοί": ["Νέα εγκατάσταση","Μερεμέτια","Ανακάινιση"],
  "Ηλεκτρολόγοι": ["Νέα εγκατάσταση","Μερεμέτια","Ανακάινιση"],
  "Ξυλουργοί": ["Ντουλάπια Κουζίνας","Ντουλάπες","Μερεμέτια","Κουφώματα"],
  "Ελαιοχρωματιστές": ["Σπατουλάρισμα-Χρωματισμός","Φρεσκάρισμα"],
  "Τοποθέτηση Πλακιδίων": ["Τοποθέτηση Μαρμάρων","Τοποθέτηση Πλακιδίων","Μερεμέτια"],
  "Γυψοσανίδες": ["Κατασκευές","Ψευδοροφές","Μερεμέτια"],
  "Οικοδομικές Εργασίες":["Χτίσιμο","Σοφάτισμα","Στέγη-Σκεπή","Μερεμέτια"],
  "Τεχνικοί Θερμομόνωσης": ["Μονώσεις Ταρατσών","Θερμοπρόσοψη"],
  "Τοποθέτηση Κουφωμάτων": ["Αλουμίνια","PVC","Μερεμέτια"],
  "Ψυκτικοί": ["Νέα εγκατάσταση","Αντλίες Θερμότητας","Συντήρηση"],
  "Κηπουροί": ["Καθαρισμός Οικοπέδων-Κήπων","Καλλωπισμός Κήπων"],
  "Πολιτικοί Μηχανικοί": ["Άδειες Δόμησης","Μελέτες","Επιβλέψεις"],
  "Οικονομολόγοι-Λογιστές": ["Φορολογικές Δηλώσεις","Λογιστικές Υπηρεσίες"],
  "Άλλη Κατηγορία": ["Διευκρινίστε στην περιγραφή"]
};


function addServiceCard() {
  const container = document.getElementById("servicesContainer");
  const index = serviceIndex;

  const card = document.createElement("div");
  card.className = "card shadow-sm rounded-4 p-4 mb-4 border-0";

  card.innerHTML = `
    <div class="row g-3">
      <!-- City Picker with Leaflet -->
      <div class="col-12">
        <label class="form-label">Επιλέξτε Πόλη / Περιοχή</label>
        <div id="map-${index}" style="height: 300px; border-radius: 1rem;"></div>
        <input type="hidden" name="services[${index}][Poli]" id="selectedCity-${index}" required>
        <p class="text-muted small mt-1">Κάντε κλικ στον χάρτη για να επιλέξετε την πόλη ή περιοχή.</p>
      </div>

      <!-- Specialty -->
      <div class="col-12">
        <label class="form-label">Επιλέξτε Ειδικότητα</label>
        <select class="form-select rounded-pill w-100"
          onchange="generateSubOptions(this.value, ${index})"
          name="services[${index}][Eidikotites]" required>
          <option value="">🛠 Επιλέξτε Ειδικότητα</option>
          ${Object.keys(optionsMap).map(cat =>
            `<option>${cat}</option>`).join("")}
        </select>
      </div>

      <!-- Subcategories -->
      <div class="col-12">
        <div id="additional-${index}" class="mt-2"></div>
      </div>


       <!-- Price -->
      <div class="col-12">
        <label class="form-label">Ενδεικτική Τιμή (€)</label>
        <input type="number"
          class="form-control rounded-pill w-100"
          name="services[${index}][Timi]">
      </div>



      <!-- Extra Work -->
      <div class="col-12">
        <label class="form-label">Πρόσθετες Εργασίες</label>
        <textarea class="form-control rounded-4 w-100"
          name="services[${index}][Prosthetes]"
          rows="2"></textarea>
      </div>
  
      
      <!-- Availability -->
      <div class="col-12">
        <label class="form-label">Διαθεσιμότητα</label>
        <input type="text"
          class="form-control rounded-pill w-100"
          name="services[${index}][Diathesimotita]"
          required>
      </div> 
      
      <!-- Phone -->
      <div class="col-12">
        <label class="form-label">Τηλέφωνο</label>
        <input type="tel"
          class="form-control rounded-pill w-100"
          name="services[${index}][Phone]"
          required>
      </div>

    </div>
  `;

  container.appendChild(card);

  // Wait for the DOM to render before initializing Leaflet
  requestAnimationFrame(() => {
    const mapContainer = document.getElementById(`map-${index}`);
    if (!mapContainer) return;

    const map = L.map(`map-${index}`, { scrollWheelZoom: true }).setView([39.0742, 21.8243], 6);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    let marker;
    map.on('click', function(e) {
      if(marker) map.removeLayer(marker);
      marker = L.marker(e.latlng).addTo(map);

      // Reverse geocode using Nominatim
      fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${e.latlng.lat}&lon=${e.latlng.lng}`)
        .then(res => res.json())
        .then(data => {
          const city = data.address.city || data.address.town || data.address.village || data.address.county;
          document.getElementById(`selectedCity-${index}`).value = city || "";
        });
    });

    // Important: call invalidateSize after the map is fully visible
    setTimeout(() => {
      map.invalidateSize();
    }, 200);
  });

  serviceIndex++;
}


function removeLastServiceCard() {
  const container = document.getElementById("servicesContainer");
  const cards = container.querySelectorAll(".card");
  if(cards.length > 1){
    cards[cards.length-1].remove();
    serviceIndex--;
  } else {
    alert("Πρέπει να υπάρχει τουλάχιστον μία πόλη.");
  }
}

function generateSubOptions(category, index) {
  const container = document.getElementById(`additional-${index}`);
  container.innerHTML = "";
  const suboptions = optionsMap[category];
  if(!suboptions) return;
  suboptions.forEach((item, i) => {
    container.innerHTML += `
      <div class="form-check">
        <input class="form-check-input"
               type="checkbox"
               name="services[${index}][Epimerous][]"
               value="${item}"
               id="sub-${index}-${i}">
        <label class="form-check-label" for="sub-${index}-${i}">
          ${item}
        </label>
      </div>
    `;
  });
}

// Auto add first card
document.addEventListener("DOMContentLoaded", function () {
  addServiceCard();
});
</script>

</body>
</html>