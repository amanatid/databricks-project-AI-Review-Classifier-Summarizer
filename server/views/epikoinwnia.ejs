<%- include("partials/header.ejs") %>


<!-- Επικοινωνία Section -->
<section id="epikoinonia" class="py-5 bg-light">
  <div class="container">
    <div class="text-center mb-4">
      <h2 class="fw-bold">Επικοινωνία</h2>
      <p class="text-muted">Επικοινωνήστε μαζί μας για οποιαδήποτε ερώτηση ή υποστήριξη.</p>
    </div>

    <% if ( locals.submitbutton) { %> 
      <div class="alert alert-warning alert-dismissible  show" role="alert">
           
              <%= message %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div> 
  <%} %>      


    <div class="row justify-content-center">
      <div class="col-md-8">

        
        <form    action="/submitepikoinwnia" method ="POST">

          <div class="mb-3">
            <label for="name" class="form-label">Όνομα</label>
            <input type="text" class="form-control rounded-pill" name="name" placeholder="Το όνομά σας" required>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control rounded-pill"name="email" placeholder="Το email σας" required>
          </div>

          <div class="mb-3">
            <label for="message" class="form-label">Μήνυμα</label>
            <textarea class="form-control rounded-4" name="text" rows="5" placeholder="Το μήνυμά σας" required></textarea>
          </div>

          <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">
            Αποστολή Μηνύματος
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

 

<%- include("partials/footer.ejs") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>
    
