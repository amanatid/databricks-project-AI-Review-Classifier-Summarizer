<%- include("partials/header.ejs") %>

<link rel="stylesheet"
 href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-5 px-2 d-flex justify-content-center">

<div class="card shadow-lg rounded-4 p-4 border-0 w-100"  
     style="max-width: 800px; background-color: #fefdf9;">

  <div class="text-center mb-4">
    <h3 class="fw-bold">
      <i class="bi bi-person-badge"></i>
      Οι Κάρτες Μου
    </h3>
  </div>

  <hr class="my-4">

  <div class="row g-4">

  <% if (techniciancards && techniciancards.length > 0) { %>
    
    <% techniciancards.forEach(function(item) { %>
      
  <div class="<%= techniciancards.length === 1 ? 'col-12' : 'col-md-6' %>">
      <div class="card technician-card border-0 h-100 shadow-sm">
        <div class="card-body p-4 d-flex flex-column">

         <div class="text-center mb-3"> <h4 class="fw-bold text-dark">
             <%= item.Onoma %> <%= item.Epitheto %> </h4> </div>
              <p class="mb-1"> 
                <i class="bi bi-award-fill me-2" style="color: #009150;" >
              </i><strong>Ειδικότητα:</strong> <span class="custom-badge" 
              style="font-size: 14px; padding: 6px 14px;" ><b> <%= item.Eidikotita %> 
            </b></span>
             </p>

          <% if (item.Epimerous1) { %>
            <% item.Epimerous1.split(',').forEach(function(word) { %>
              <p class="text-muted small mb-1">
                ✔️ <%= word.trim() %>
              </p>
            <% }) %>
          <% } %>

          <p><i class="bi bi-tools me-2"></i><strong>Πρόσθετες:</strong> <%= item.Prosthetes %></p>
          <p><i class="bi bi-cash-coin text-success me-2"></i><strong>Τιμή:</strong> €<%= item.Timi %></p>
          <p class="mb-1"> <i class="bi bi-geo-alt-fill me-2" style="color: #85c1f3;" >
          </i><strong>Πόλη:</strong><%= item.Poli %> </p>
           <p><i class="bi bi-calendar-check-fill text-info me-2"></i><strong>Διαθεσιμότητα:</strong>
             <%= item.Diathesimotita %></p> 
             <a href="tel:<%= item.Phone %>" 
                class="btn phone-button w-100 mb-2 rounded-pill">
             <i class="bi bi-telephone-fill me-2"></i> <%= item.Phone %> </a>

          <div class="d-flex justify-content-between mt-auto">

            <button class="btn btn-outline-primary btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#editModal<%= item.id %>">
              <i class="bi bi-pencil-square"></i> Επεξεργασία
            </button>

           <form action="/delete-card/<%= item.id %>?_method=DELETE"
                    method="POST"
                    onsubmit="return confirm('Είστε σίγουρος για διαγραφή;')">

                <button class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash"></i> Διαγραφή
                </button>
           </form>

          </div>

        </div>
      </div>
    </div>

    <% }) %>

  <% } else { %>
    <p class="text-center text-muted">Δεν υπάρχουν κάρτες.</p>
  <% } %>

  </div>
</div>
</div>


<!-- ================= MODALS OUTSIDE CARDS ================= -->

<% if (techniciancards && techniciancards.length > 0) { %>
  <% techniciancards.forEach(function(item) { %>

<div class="modal fade"
     id="editModal<%= item.id %>"
     tabindex="-1"
     aria-hidden="true">

  <div class="modal-dialog">
    <div class="modal-content rounded-4">

     
     
        <form class="edit-form"
      data-id="<%= item.id %>"
      data-epimerous="<%= item.Epimerous1 || '' %>"
      data-diath="<%= item.Diathesimotita || '' %>">
        

        <div class="modal-header">
          <h5 class="modal-title">Επεξεργασία Κάρτας</h5>
          <button type="button"
                  class="btn-close"
                  data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">

        

         <!-- Ειδικότητα -->
                <div class="mb-3">

                  <label class="form-label">Ειδικότητα</label>

                  
                  <select class="form-select eidikotita-select"
                          name="Eidikotites"
                          data-id="<%= item.id %>"
                          data-original="<%= item.Eidikotites %>"
                          required> 
                    
                   

                    <% Object.keys(professionMap).forEach(function(cat){ %>
                      <option value="<%= cat %>"
                        <%= item.Eidikotites === cat ? 'selected' : '' %>>
                        <%= cat %>
                      </option>
                    <% }) %>

                  </select>
                </div>
               
               
              
 

                
           
                <!-- Epimerous -->
                <div class="mb-3">
                  <label class="form-label">Επιμέρους</label>
                 
                  
                  <div id="edit-additional-<%= item.id %>"> 
                 
                  </div>
                </div>

             <div class="mb-3">
              <label class="form-label">Πρόσθετες Εργασίες</label>
              <textarea class="form-control"
                        name="Prosthetes"><%= item.Prosthetes %></textarea>
          </div>



            <div class="mb-3">

                    <label class="form-label">Περιφέρεια</label>

                    <select class="form-select region-select"
                            name="Perifereia"
                            data-id="<%= item.id %>" 
                            required>

                   
                     <option value="<%= item.Perifereia %>"><%= item.Perifereia ? item.Perifereia :  "Όλες"%></option>

                   

                    </select>

                    <label class="form-label">Νομός</label>

                    <select class="form-select pref-select"  
                            name="Nomos"
                            data-id="<%= item.id %>"
                            required>

                    <option value="<%= item.Nomos %>"><%= item.Nomos ? item.Nomos :  "Όλοι"%></option>

                    </select>

                    <label class="form-label">Επιλογή Πόλης</label>

                    <select class="form-select city-select"
                        name="Poli"
                        data-id="<%= item.id %>"
                        data-selected="<%= item.Poli %>"
                        required>

                    <option value="<%= item.Poli %>"><%= item.Poli %></option>

                    </select>

            </div>

          

          
          <div class="mb-3">
            <label class="form-label">Ενδεικτική Τιμή (€)</label>
            <input type="number" class="form-control"
                   name="Timi"
                   value="<%= item.Timi %>">
          </div>

         

          <div class="mb-3">
  <label class="form-label">Διαθεσιμότητα</label>

  <!-- Mode -->
  <select class="form-select mb-2"
          id="edit-mode-<%= item.id %>"
          onchange="toggleEditMode('<%= item.id %>')">
    <option value="range">Εύρος ημερών</option>
    <option value="specific">Συγκεκριμένες ημέρες</option>
  </select>

    <!-- RANGE -->
    <div id="edit-range-<%= item.id %>" class="row g-2 mb-2">
          <div class="col-6">
            <label>Από</label>
            <select class="form-select" id="edit-day-from-<%= item.id %>">
                <option value="">Επιλέξτε</option>
                <% ["Δευτέρα","Τρίτη","Τετάρτη","Πέμπτη","Παρασκευή","Σάββατο","Κυριακή"].forEach(function(d){ %>
                  <option value="<%= d %>"><%= d %></option>
                <% }) %>
            </select>
          </div>
          <div class="col-6">
          <label>Έως</label>
            <select class="form-select" id="edit-day-to-<%= item.id %>">
                  <option value="">Επιλέξτε</option>
                  <% ["Δευτέρα","Τρίτη","Τετάρτη","Πέμπτη","Παρασκευή","Σάββατο","Κυριακή"].forEach(function(d){ %>
                    <option value="<%= d %>"><%= d %></option>
                  <% }) %>
            </select>
          </div>
        </div>

        <!-- SPECIFIC -->
        <div id="edit-specific-<%= item.id %>" style="display:none;" class="row g-2 mb-2">
            <% ["Δευτέρα","Τρίτη","Τετάρτη","Πέμπτη","Παρασκευή","Σάββατο","Κυριακή"].forEach(function(d,i){ %>
              <div class="col-6">
                <div class="form-check">
                  <input type="checkbox"
                        class="form-check-input edit-day-<%= item.id %>"
                        value="<%= d %>">
                  <label class="form-check-label"><%= d %></label>
              </div>
            </div>
          <% }) %>
        </div>

        <!-- TIME -->
    
       <div class="row g-2">
  
          <div class="col-6">
            <label class="form-label">Ώρα Από</label>
            <select class="form-select" id="edit-from-<%= item.id %>">
              <option value="">--:--</option>
              <% for(let h=0; h<24; h++){ for(let m of [0,30]){ %>
                <option value="<%= String(h).padStart(2,'0') %>:<%= String(m).padStart(2,'0') %>">
                  <%= String(h).padStart(2,'0') %>:<%= String(m).padStart(2,'0') %>
                </option>
              <% }} %>
            </select>
          </div>

          <div class="col-6">
            <label class="form-label">Ώρα Έως</label>
            <select class="form-select" id="edit-to-<%= item.id %>">
              <option value="">--:--</option>
              <% for(let h=0; h<24; h++){ for(let m of [0,30]){ %>
                <option value="<%= String(h).padStart(2,'0') %>:<%= String(m).padStart(2,'0') %>">
                  <%= String(h).padStart(2,'0') %>:<%= String(m).padStart(2,'0') %>
                </option>
              <% }} %>
            </select>
          </div>

       </div>

  <!-- FINAL VALUE -->
  <input type="hidden"
         name="Diathesimotita"
         id="edit-diath-<%= item.id %>">
</div>

         <div class="mb-3">
            <label class="form-label">Τηλέφωνο </label>
            <input type="text" class="form-control"
                   name="Phone"
                   value="<%= item.Phone %>">
          </div>


        </div>

        <div class="modal-footer">
          <button type="button"
                  class="btn btn-secondary"
                  data-bs-dismiss="modal">
            Ακύρωση
          </button>
          <button type="submit"
                  class="btn btn-primary">
            Αποθήκευση
          </button>
        </div>

      </form>

    </div>
  </div>
</div>

  <% }) %>
<% } %>


<%- include("partials/footer.ejs") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
  window.greekMunicipalities = <%- JSON.stringify(greekMunicipalities) %>;
</script>

<script>
const regions = [...new Set(greekMunicipalities.map(m => m.region))];    

const optionsMap = <%- JSON.stringify(optionsMap) %>;
const professionMap = <%- JSON.stringify(professionMap) %>;

// =================== Step 1: store original Epimerous for each card ===================
const originalEpimerousMap = {};
<% techniciancards.forEach(function(item) { %>
  originalEpimerousMap["<%= item.id %>"] = {
    eidikotita: "<%= item.Eidikotites %>",
    epimerous: "<%= (item.Epimerous1 || '') %>"
  };
<% }) %>

//

function generateEditSubOptions(category, id, preselected = []) {

  const container = document.getElementById(`edit-additional-${id}`);
  container.innerHTML = "";

  const suboptions = optionsMap[category];
  if (!suboptions) return;

  // normalize
  preselected = preselected.map(s => s.trim().toLowerCase());

  suboptions.forEach((item, i) => {

    const checked =
      preselected.includes(item.trim().toLowerCase())
      ? "checked"
      : "";

    container.innerHTML += `
      <div class="form-check">
        <input class="form-check-input"
               type="checkbox"
               name="Epimerous1[]"
               value="${item}"
               id="edit-${id}-${i}"
               ${checked}>
        <label class="form-check-label"
               for="edit-${id}-${i}">
          ${item}
        </label>
      </div>
    `;
  });
}

function populatePrefectures(region, prefSelect){

prefSelect.innerHTML = '<option value="">Όλοι</option>';

const prefs = [...new Set(
  greekMunicipalities
  .filter(m => !region || m.region === region)
  .map(m => m.prefecture)
)];

prefs.forEach(pref => {

const opt = document.createElement("option");

opt.value = pref;
opt.textContent = pref;

prefSelect.appendChild(opt);

});

}


function populateCities(region, pref, citySelect){

citySelect.innerHTML = '<option value="">🔄 Όλες οι Πόλεις</option>';

const cities = greekMunicipalities
  .filter(m =>
    (!region || m.region === region) &&
    (!pref || m.prefecture === pref)
  )
  .sort((a, b) => a.city.localeCompare(b.city, 'el')); // 🔥 SORT HERE

cities.forEach(city => {

const opt = document.createElement("option");

opt.value = city.city;
opt.textContent = city.city;

citySelect.appendChild(opt);

});

}

function loadAllCitiesEdit(select){

  select.innerHTML = '<option value="">🔄 Όλες οι Πόλεις</option>';

  const sorted = [...greekMunicipalities]
    .sort((a, b) => a.city.localeCompare(b.city, 'el')); // 🔥 SORT

  sorted.forEach(m => {
    const opt = document.createElement("option");
    opt.value = m.city;
    opt.textContent = m.city;
    select.appendChild(opt);
  });

}


document.addEventListener("DOMContentLoaded", function(){

document.querySelectorAll(".region-select").forEach(regionSelect => {

const id = regionSelect.dataset.id;

const prefSelect =
document.querySelector(`.pref-select[data-id="${id}"]`);

const citySelect =
document.querySelector(`.city-select[data-id="${id}"]`);

// 🔥 LOAD ALL CITIES BY DEFAULT (LIKE MAIN FORM)
loadAllCitiesEdit(citySelect);

/* -------- LOAD REGIONS -------- */

regions.forEach(region => {

const opt = document.createElement("option");

opt.value = region;
opt.textContent = region;

regionSelect.appendChild(opt);

});

/* -------- REGION CHANGE -------- */

regionSelect.addEventListener("change", function(){

populatePrefectures(this.value, prefSelect);

populateCities(this.value, "", citySelect);

});

/* -------- PREF CHANGE -------- */

prefSelect.addEventListener("change", function(){

populateCities(regionSelect.value, this.value, citySelect);

});

// 🔥 CITY CHANGE (LIKE MAIN FORM)


citySelect.addEventListener("change", function(){

  const city = this.value;

  if(!city){

    // ✅ RESET EVERYTHING
    regionSelect.value = "";

    prefSelect.innerHTML = '<option value="">Όλοι οι Νομοί</option>';

    loadAllCitiesEdit(citySelect);

    return;
  }

  const match = greekMunicipalities.find(m => m.city === city);

  if(match){

    regionSelect.value = match.region;

    populatePrefectures(match.region, prefSelect);
    prefSelect.value = match.prefecture;

    populateCities(match.region, match.prefecture, citySelect);

    citySelect.value = city;
  }

});

});



    
document.querySelectorAll(".modal").forEach(modal => {

  modal.addEventListener("show.bs.modal", function () {

   
    const form = this.querySelector(".edit-form");
    const id = form.dataset.id;

    const regionSelect = this.querySelector(`.region-select[data-id="${id}"]`);
    const prefSelect   = this.querySelector(`.pref-select[data-id="${id}"]`);
    const citySelect   = this.querySelector(`.city-select[data-id="${id}"]`);

    const selectedCity = citySelect.dataset.selected;

      // 🔁 RESET DROPDOWNS
      regionSelect.innerHTML = '<option value="">Όλες οι Περιφέρειες</option>';
      prefSelect.innerHTML   = '<option value="">Όλοι οι Νομοί</option>';

      // 🔹 Load regions
      regions.forEach(region => {
        const opt = document.createElement("option");
        opt.value = region;
        opt.textContent = region;
        regionSelect.appendChild(opt);
      });

      // 🔍 Find selected city
      const match = greekMunicipalities.find(m => m.city === selectedCity);

      if(match){

        // set region
        regionSelect.value = match.region;

        // populate prefectures
        populatePrefectures(match.region, prefSelect);
        prefSelect.value = match.prefecture;

        // populate cities (correct filtering!)
        populateCities(match.region, match.prefecture, citySelect);

        // set city
        citySelect.value = selectedCity;

      } else {

        // fallback
        loadAllCitiesEdit(citySelect);
        citySelect.value = selectedCity;
      }

    // find original data (from EJS)
    const item = {
      eidikotita: form.querySelector(".eidikotita-select").getAttribute("data-original"),
      epimerous: form.getAttribute("data-epimerous")
    };

    // reset select
    const select = form.querySelector(".eidikotita-select");
    select.value = item.eidikotita;

    // parse epimerous
    const preselected = item.epimerous
      .split(",")
      .map(s => s.trim())
      .filter(Boolean);

    // regenerate checkboxes correctly
    generateEditSubOptions(item.eidikotita, id, preselected);

    // ================= PARSE Diathesimotita =================
const raw = form.dataset.diath;

  if(raw){

      // Split time
      const timeMatch = raw.match(/\((.*?)\)/);

      let timeFrom = "";
      let timeTo = "";

    if(timeMatch){
      const times = timeMatch[1]
        .split("-")
        .map(t => t.trim());   // IMPORTANT

      timeFrom = times[0] || "";
      timeTo = times[1] || "";
    }

      // Remove time part
      const daysPart = raw.replace(/\(.*?\)/, "").trim();

      // Detect RANGE or SPECIFIC
      if(daysPart.includes("–")){

        // -------- RANGE --------
        document.getElementById(`edit-mode-${id}`).value = "range";
        toggleEditMode(id);

        const [from, to] = daysPart.split("–");

        document.getElementById(`edit-day-from-${id}`).value = from.trim();
        document.getElementById(`edit-day-to-${id}`).value = to.trim();

      } else {

        // -------- SPECIFIC --------
        document.getElementById(`edit-mode-${id}`).value = "specific";
        toggleEditMode(id);

        const selectedDays = daysPart.split(",").map(d => d.trim());

        document.querySelectorAll(`.edit-day-${id}`).forEach(cb => {
          if(selectedDays.includes(cb.value)){
            cb.checked = true;
          }
        });
      }

  // -------- TIME --------
  document.getElementById(`edit-from-${id}`).value = timeFrom;
  document.getElementById(`edit-to-${id}`).value = timeTo;
}

  });

});
  // change dropdown dynamically
  // ================= FIX CHANGE BEHAVIOR =================
// =================== Step 2: dynamic Epimerous update ===================
document.querySelectorAll(".eidikotita-select").forEach(select => {

  select.addEventListener("change", function(){
    const id = this.dataset.id;
    const newValue = this.value;

    let preselected = [];

    // if user selected back the original Eidikotita, use original Epimerous
    if(originalEpimerousMap[id] && newValue === originalEpimerousMap[id].eidikotita){
      preselected = originalEpimerousMap[id].epimerous
                      .split(',')
                      .map(s => s.trim())
                      .filter(Boolean);
    }

    generateEditSubOptions(newValue, id, preselected);
  });

});
  // submit edit
  document.querySelectorAll(".edit-form")
    .forEach(form => {

        form.addEventListener("submit", async function(e){

        const id = this.dataset.id;

        const mode = document.getElementById(`edit-mode-${id}`).value;
        const dayFrom = document.getElementById(`edit-day-from-${id}`).value;
        const dayTo = document.getElementById(`edit-day-to-${id}`).value;
        const checkboxes = document.querySelectorAll(`.edit-day-${id}`);
        const timeFrom = document.getElementById(`edit-from-${id}`).value;
        const timeTo = document.getElementById(`edit-to-${id}`).value;

        const weekdays = {
          "Δευτέρα":1,"Τρίτη":2,"Τετάρτη":3,"Πέμπτη":4,
          "Παρασκευή":5,"Σάββατο":6,"Κυριακή":7
        };

        let availability = "";

        if(mode === "range"){
          if(!dayFrom || !dayTo || dayFrom === dayTo || weekdays[dayFrom] > weekdays[dayTo]){
            alert("Λάθος εύρος ημερών");
            e.preventDefault();
            return;
          }
          availability = `${dayFrom}–${dayTo}`;
        } else {
          const days = Array.from(checkboxes).filter(c=>c.checked).map(c=>c.value);
          if(days.length === 0){
            alert("Επιλέξτε τουλάχιστον μία ημέρα");
            e.preventDefault();
            return;
          }
          availability = days.join(", ");
        }

        if(!timeFrom || !timeTo || timeFrom >= timeTo){
          alert("Λάθος ώρα");
          e.preventDefault();
          return;
        }

        availability += ` (${timeFrom}-${timeTo})`;

        document.getElementById(`edit-diath-${id}`).value = availability;

        // CONTINUE NORMAL SUBMIT
        const response = await fetch(`/edit-card/${id}`, {
          method: "POST",
          body: new URLSearchParams(new FormData(this))
        });

        const result = await response.json();

        if(result.success){
          window.location.href = "/mycards";
        }

});

  });

});


function toggleEditMode(id){
  const mode = document.getElementById(`edit-mode-${id}`).value;

  const range = document.getElementById(`edit-range-${id}`);
  const specific = document.getElementById(`edit-specific-${id}`);

  if(mode === "range"){
    range.style.display = "flex";
    specific.style.display = "none";
  } else {
    range.style.display = "none";
    specific.style.display = "flex";
  }
}
</script>

</body>
</html>