<%- include("partials/header.ejs") %>

<div class="container my-5 d-flex justify-content-center">
  <div class="card shadow-lg rounded-4 p-4 w-100" style="max-width:600px;">

    <h4 class="text-center fw-bold mb-4">
      <i class="bi bi-star-fill text-warning"></i>
      Αξιολόγηση Τεχνίτη
    </h4>

    <!-- <form action="/submit-review/< %=technician.id %>" method="POST" class="row g-3"> -->
        <form action="/evaluation/" method="POST" class="row g-3"></form>

      <!-- Reliability -->
      <div class="col-12">
        <label class="form-label">Αξιοπιστία</label>
        <input type="range" name="reliability" min="1" max="5" value="3" class="form-range">
      </div>

      <!-- Consistency -->
      <div class="col-12">
        <label class="form-label">Συνέπεια</label>
        <input type="range" name="consistency" min="1" max="5" value="3" class="form-range">
      </div>

      <!-- Quality -->
      <div class="col-12">
        <label class="form-label">Ποιότητα</label>
        <input type="range" name="quality" min="1" max="5" value="3" class="form-range">
      </div>

      <!-- Response -->
      <div class="col-12">
        <label class="form-label">Απόκριση</label>
        <input type="range" name="response" min="1" max="5" value="3" class="form-range">
      </div>

      <!-- Price -->
      <div class="col-12">
        <label class="form-label">Τιμή vs Συμφωνία</label>
        <input type="range" name="price" min="1" max="5" value="3" class="form-range">
      </div>

      <!-- Completed -->
      <div class="col-12">
        <label class="form-label">Ολοκληρώθηκε το έργο;</label>
        <select name="completed" class="form-select">
          <option value="true">Ναι</option>
          <option value="false">Όχι</option>
        </select>
      </div>

      <!-- Days -->
      <div class="col-12">
        <label class="form-label">Ημέρες ολοκλήρωσης</label>
        <input type="number" name="days" class="form-control">
      </div>

      <!-- Comment -->
      <div class="col-12">
        <label class="form-label">Σχόλιο</label>
        <textarea name="comment" class="form-control"></textarea>
      </div>

      <button class="btn btn-success w-100 mt-3 rounded-pill">
        Υποβολή Αξιολόγησης
      </button>

    </form>

  </div>
</div>

<%- include("partials/footer.ejs") %>