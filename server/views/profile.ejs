<%- include("partials/header.ejs") %>

<div class="container my-5 d-flex justify-content-center">
  <div class="card shadow-lg rounded-4 p-4 w-100"
       style="max-width: 600px; background-color:#fefdf9;">

    <div class="text-center mb-4">
      <h3 class="fw-bold">
        <i class="bi bi-person-circle me-2"></i>
        Το Προφίλ μου
      </h3>
      <p class="text-muted">Διαχειριστείτε τον λογαριασμό σας</p>
    </div>

    <% if (locals.message) { %>
      <div class="alert alert-info text-center">
        <%= message %>
      </div>
    <% } %>

    <!-- ================= CHANGE PASSWORD ================= -->
    <div class="mb-4">
      <h5 class="fw-bold">
        <i class="bi bi-shield-lock me-2"></i>
        Αλλαγή Κωδικού
      </h5>

      <form action="/change-password" method="POST" class="row g-3 mt-2">

        <!-- CURRENT PASSWORD -->
        <div class="col-12 position-relative">
          <label class="form-label">Τρέχων Κωδικός</label>
          <input type="password"
                 name="currentPassword"
                 class="form-control rounded-pill pe-5"
                 required>
          <i class="bi bi-eye-fill toggle-password"
             style="position:absolute; right:15px; top:38px; cursor:pointer;"></i>
        </div>

        <!-- NEW PASSWORD -->
        <div class="col-12 position-relative">
          <label class="form-label">Νέος Κωδικός</label>
          <input type="password"
                 name="newPassword"
                 class="form-control rounded-pill pe-5"
                 minlength="7"
                 required>
          <i class="bi bi-eye-fill toggle-password"
             style="position:absolute; right:15px; top:38px; cursor:pointer;"></i>
        </div>

        <!-- CONFIRM PASSWORD -->
        <div class="col-12 position-relative">
          <label class="form-label">Επιβεβαίωση Νέου Κωδικού</label>
          <input type="password"
                 name="confirmPassword"
                 class="form-control rounded-pill pe-5"
                 minlength="7"
                 required>
          <i class="bi bi-eye-fill toggle-password"
             style="position:absolute; right:15px; top:38px; cursor:pointer;"></i>
        </div>

        <div class="col-12">
          <button class="btn btn-success w-100 rounded-pill">
            <i class="bi bi-check-circle me-2"></i>
            Αλλαγή Κωδικού
          </button>
        </div>

      </form>
    </div>

    <hr class="my-4">

    <!-- ================= DELETE ACCOUNT ================= -->
    <div class="text-center">

      <h6 class="text-danger fw-bold mb-3">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Διαγραφή Λογαριασμού
      </h6>

      <button class="btn btn-outline-danger rounded-pill"
              data-bs-toggle="modal"
              data-bs-target="#deleteModal">
        Διαγραφή Λογαριασμού
      </button>

    </div>

  </div>
</div>

<!-- ================= DELETE MODAL ================= -->

<div class="modal fade" id="deleteModal">
  <div class="modal-dialog">
    <div class="modal-content rounded-4">

      <div class="modal-header">
        <h5 class="modal-title text-danger">
          ⚠ Διαγραφή Λογαριασμού
        </h5>
        <button type="button" class="btn-close"
                data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">

        <p>Είστε σίγουρος ότι θέλετε να διαγράψετε τον λογαριασμό σας;</p>

        <p class="text-danger fw-bold">
          Αυτή η ενέργεια δεν μπορεί να αναιρεθεί.
        </p>

        <form action="/delete-account" method="POST">

          <label class="form-label">
            Πληκτρολογήστε <b>DELETE</b> για επιβεβαίωση
          </label>

          <input type="text"
                 name="confirmText"
                 class="form-control"
                 required>

          <button class="btn btn-danger w-100 mt-3">
            Διαγραφή Οριστικά
          </button>

        </form>

      </div>

    </div>
  </div>
</div>

<%- include("partials/footer.ejs") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
/* ================= SHOW / HIDE PASSWORD ================= */

document.querySelectorAll(".toggle-password").forEach(icon => {

  icon.addEventListener("click", function(){

    const input = this.previousElementSibling;

    const type = input.type === "password" ? "text" : "password";
    input.type = type;

    // change icon
    this.classList.toggle("bi-eye-fill");
    this.classList.toggle("bi-eye-slash-fill");

  });

});
</script>