<script>
  const municipalities = <%- JSON.stringify(greekMunicipalities) %>;
</script>
  
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
 

<script>
  const regionSelect = document.getElementById("region");
  const prefectureSelect = document.getElementById("prefecture");
  const citySelect = document.getElementById("city");

  // Unique Regions
  const regions = [...new Set(municipalities.map(m => m.region))];

    // Populate ALL cities initially
  const allCities = [...new Set(municipalities.map(m => m.city))];

  allCities.forEach(c => {
    const option = document.createElement("option");
    option.value = c;
    option.textContent = c;
    citySelect.appendChild(option);
  });

  regions.forEach(r => {
    const option = document.createElement("option");
    option.value = r;
    option.textContent = r;
    regionSelect.appendChild(option);
  });

  // When Region changes → filter Prefectures
 regionSelect.addEventListener("change", () => {
  const selectedRegion = regionSelect.value;

  prefectureSelect.innerHTML = '<option value="">Όλοι οι Νομοί</option>';
  citySelect.innerHTML = '<option value="">Όλες οι Πόλεις</option>';

  let filtered = municipalities;

  if (selectedRegion) {
    filtered = municipalities.filter(m => m.region === selectedRegion);
  }

  const prefectures = [...new Set(filtered.map(m => m.prefecture))];
  const cities = [...new Set(filtered.map(m => m.city))];

  prefectures.forEach(p => {
    const option = document.createElement("option");
    option.value = p;
    option.textContent = p;
    prefectureSelect.appendChild(option);
  });

  cities.forEach(c => {
    const option = document.createElement("option");
    option.value = c;
    option.textContent = c;
    citySelect.appendChild(option);
  });
});


prefectureSelect.addEventListener("change", () => {
  const selectedPrefecture = prefectureSelect.value;

  citySelect.innerHTML = '<option value="">Όλες οι Πόλεις</option>';

  let filtered = municipalities;

  if (selectedPrefecture) {
    filtered = municipalities.filter(m => m.prefecture === selectedPrefecture);
  }

  const cities = [...new Set(filtered.map(m => m.city))];

  cities.forEach(c => {
    const option = document.createElement("option");
    option.value = c;
    option.textContent = c;
    citySelect.appendChild(option);
  });
}); 

</script>

<script>
  ///////////////////
  let generatedShareURL = '';

  ////////////////////
  async function handleSubmit(event) {
    event.preventDefault();

    const speciality = document.getElementById('speciality').value;
    
    //const price = document.getElementById('price').value;
    const region = document.getElementById('region').value;
    const prefecture = document.getElementById('prefecture').value;
    const city = document.getElementById('city').value;
    

    const response = await fetch('/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ speciality, region, prefecture, city})
    });

    const result = await response.json();

    console.log("Response from server:", result);

    const container = document.getElementById('results');
   
    container.innerHTML = ''; // Clear old results
  
     
    if  ( result.data && result.data.length > 0) {
       /////////////////////////////////////////////////////////////////////////////////
      // Build and show the shareable link
      //const shareURL = `${window.location.origin}${window.location.pathname}search?speciality=${encodeURIComponent(speciality)}&city=${encodeURIComponent(city)}`;
      //const shareURL = `${window.location.origin}${window.location.pathname}search?speciality=${speciality}&city=${city}`;
        const params = new URLSearchParams();

        if (speciality) params.append('speciality', speciality);
        if (region) params.append('region', region);
        if (prefecture) params.append('prefecture', prefecture);
        if (city) params.append('city', city);

        const shareURL = `${window.location.origin}/search?${params.toString()}`;
      console.log(shareURL)

      generatedShareURL = shareURL;
      document.getElementById('shareLinkContainer').classList.remove('d-none');
      document.getElementById('copyMsg').style.display = 'none'; // Reset
      /////////////////////////////////////////////////////////////////////////////////

      result.data.forEach(item => {
        const card = document.createElement('div');
        card.className = 'col-md-6 col-lg-6">';

         if (item.Timi === null) {
          item.Timi='-'
        }
        card.innerHTML = `
       
        

        <div class="card shadow rounded-4 border-0 overflow-hidden w-100 h-100 d-flex flex-column" style="background-color: #fefdf9;">
           <div class="card-body p-4 ">
      
            <div class="text-center mb-3">
                <h4 class="fw-bold">${item.Onoma} ${item.Epitheto}</h4>
            </div>  

            <p class="mb-1">
               <i class="bi bi-award-fill  me-2"  style="color: #009150;" ></i><strong>Ειδικότητα:</strong>
              <span class="custom-badge" style="font-size: 14px; padding: 6px 14px;" ><b>${item.Eidikotita} </b></span> 
           </p>
      
            ${item.Epimerous1 ? item.Epimerous1
        .split(',')
        .map(word => `
          <p class="text-muted mb-1 fst-italic">
            <strong>✔️</strong> ${word.trim()}
          </p>
        `).join('') : ''
      }
      
           <p class="mb-1">
             <i class="bi bi-tools text-secondary me-2"></i><strong>Πρόσθετες Εργασίες:</strong> ${item.Prosthetes}
           </p>
      
          <p class="mb-1">
            <i class="bi bi-cash-coin text-success me-2"></i><strong>Ενδεικτική Τιμή:</strong> €${item.Timi}
          </p>
      
          <p class="mb-1">
            <i class="bi bi-geo-alt-fill  me-2" style="color: #85c1f3;" ></i><strong>Πόλη:</strong>${item.Poli}
          </p>
      
          <p class="mb-1">
            <i class="bi bi-calendar-check-fill text-info me-2"></i><strong>Διαθεσιμότητα:</strong> ${item.Diathesimotita}
          </p>
      
        
      
    
 
           <a href="tel:${item.Phone}"
             class="btn phone-button w-100 mb-2 rounded-pill">
            <i class="bi bi-telephone-fill me-2"></i>${item.Phone}
           </a>
         </div>
       </div>
     
        `;
        container.appendChild(card);
      });
    } else {
      container.innerHTML = '<p class="text-danger">Δεν βρέθηκαν τεχνικοί με αυτά τα κριτήρια.</p>';
    }
  }

 /////////////////////////////////////////////////////////////////////////////////
 function copyShareLink() {
  if (!generatedShareURL) return;
  //console.log(generatedShareURL);
  navigator.clipboard.writeText(generatedShareURL).then(() => {
    document.getElementById('copyMsg').style.display = 'block';
  }).catch(err => {
    console.error('Copy failed:', err);
  });
}


citySelect.addEventListener("change", () => {
  const selectedCity = citySelect.value;

  // If user selects "Όλες οι Πόλεις"
  if (!selectedCity) {

    // Reset Region & Prefecture
    regionSelect.value = "";
    prefectureSelect.innerHTML = '<option value="">Όλοι οι Νομοί</option>';

    // Reload ALL cities
    citySelect.innerHTML = '<option value="">Όλες οι Πόλεις</option>';

    const allCities = [...new Set(municipalities.map(m => m.city))];

    allCities.forEach(c => {
      const option = document.createElement("option");
      option.value = c;
      option.textContent = c;
      citySelect.appendChild(option);
    });
  }
});

 /////////////////////////////////////////////////////////////////////////////////

</script>


</body>
</html>