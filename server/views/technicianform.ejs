<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  window.greekMunicipalities = <%- JSON.stringify(greekMunicipalities) %>;
</script>


<script>

const cities = greekMunicipalities.filter(m => m.region === "Αττικής");
const optionsMap = <%- JSON.stringify(optionsMap) %>;
//console.log(cities);
</script>
<script>

let serviceIndex = 0;

/* ---------------- MUNICIPALITIES ---------------- */

/* ---------------- SERVICES ---------------- */


/* ---------------- GLOBAL SUB OPTIONS ---------------- */

function generateSubOptions(category){

const container=document.getElementById("additional-global");

container.innerHTML="";

const sub=optionsMap[category];

if(!sub) return;

sub.forEach((item,i)=>{

container.innerHTML+=`

<div class="form-check">

<input class="form-check-input"
type="checkbox"
name="Epimerous[]"
value="${item}"
id="sub-${i}">

<label class="form-check-label" for="sub-${i}">
${item}
</label>

</div>

`;

});

}



function sortGreek(arr) {
  return arr.sort((a, b) => a.localeCompare(b, 'el'));
}

/* ---------------- ADD CITY CARD ---------------- */

function addServiceCard(){

const container=document.getElementById("servicesContainer");

const index=serviceIndex;

const card=document.createElement("div");

card.className="card shadow-sm rounded-4 p-4 mb-4 border-0";

card.innerHTML=`

<div class="row g-3">

<div class="col-12">

<label class="form-label">Πρόσθετες Εργασίες</label>


<input type="text"
class="form-control rounded-pill"
name="services[${index}][Prosthetes]" required>

</div>  

<div class="col-12">

<label class="form-label">Περιφέρεια</label>

<select id="region-${index}" class="form-select mb-2" name="services[${index}][Perifereia]" required>

<option value="">Όλες οι Περιφέρειες</option>


</select>

<label class="form-label">Νομός</label>

<select id="pref-${index}" class="form-select mb-3"
name="services[${index}][Nomos]" required
>

<option value="">Όλοι οι Νομοί</option>

</select>


<label class="form-label">Επιλογή Πόλης</label>

<select class="form-select rounded-pill"
id="city-${index}"
name="services[${index}][Poli]" required>

<option value="">🔄 Όλες οι Πόλεις</option>

</select>

<div id="map-${index}"
style="height:300px;border-radius:1rem;margin-top:10px;"></div>

</div>




<div class="col-12">

<label class="form-label">Ενδεικτική  Τιμή (€)</label>

<input type="number"
class="form-control rounded-pill"
name="services[${index}][Timi]">

</div>



<div class="col-12">
  <label class="form-label">Διαθεσιμότητα</label>

  <!-- Mode selection: Range or Specific -->
  <div class="mb-2">
    <select class="form-select" id="mode-${index}" onchange="toggleMode(${index})">
      <option value="range">Εύρος ημερών</option>
      <option value="specific">Συγκεκριμένες ημέρες</option>
    </select>
  </div>

  <!-- Range of days -->
  <div class="row g-2 mb-2" id="range-container-${index}">
    <div class="col-6">
      <label class="form-label">Από</label>
      <select class="form-select" name="services[${index}][DayFrom]" id="day-from-${index}">
        ${["Δευτέρα","Τρίτη","Τετάρτη","Πέμπτη","Παρασκευή","Σάββατο","Κυριακή"].map(day => `<option>${day}</option>`).join('')}
      </select>
    </div>
    <div class="col-6">
      <label class="form-label">Έως</label>
      <select class="form-select" name="services[${index}][DayTo]" id="day-to-${index}">
        ${["Δευτέρα","Τρίτη","Τετάρτη","Πέμπτη","Παρασκευή","Σάββατο","Κυριακή"].map(day => `<option>${day}</option>`).join('')}
      </select>
    </div>
  </div>

  <!-- Specific days -->
  <div class="row g-2 mb-2" id="specific-container-${index}" style="display:none;">
    ${["Δευτέρα","Τρίτη","Τετάρτη","Πέμπτη","Παρασκευή","Σάββατο","Κυριακή"].map((day,i) => `
      <div class="col-6 col-md-4">
        <div class="form-check">
          <input class="form-check-input day-checkbox-${index}" type="checkbox"
                 name="services[${index}][Days][]" value="${day}" id="day-${index}-${i}">
          <label class="form-check-label" for="day-${index}-${i}">${day}</label>
        </div>
      </div>
    `).join('')}
  </div>

  <!-- Time range -->
  <div class="row g-2">
    <div class="col-6">
      <label class="form-label">Ώρα Από</label>
        <select class="form-select" name="services[${index}][TimeFrom]" id="from-${index}">
              ${generateTimeOptions()}
         </select>
    </div>
    <div class="col-6">
      <label class="form-label">Ώρα Έως</label>
       <select class="form-select" name="services[${index}][TimeTo]" id="to-${index}">
            ${generateTimeOptions()}
       </select>
    </div>
  </div>
  <input type="hidden" name="services[${index}][Diathesimotita]" id="diath-${index}">
</div>


<div class="col-12">

<label class="form-label">Τηλέφωνο</label>

<input type="tel"
class="form-control rounded-pill"
name="services[${index}][Phone]" required>

</div>

</div>

`;

container.appendChild(card);

/* ---------------- MAP ---------------- */

const map=L.map(`map-${index}`).setView([39.0742,21.8243],7);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
attribution:'© OpenStreetMap'
}).addTo(map);

let marker;

/* ---------------- SELECT ELEMENTS ---------------- */

const regionSelect=document.getElementById(`region-${index}`);

const prefSelect=document.getElementById(`pref-${index}`);

const citySelect=document.getElementById(`city-${index}`);

/* LOAD ALL CITIES BY DEFAULT */
loadAllCities(citySelect);

/* make dropdown scrollable */


/* -------- LOAD ALL CITIES BY DEFAULT -------- */

function loadAllCities(select){

  select.innerHTML = '<option value="">🔄 Όλες οι Πόλεις</option>';

 const cities = [...new Set(greekMunicipalities.map(m => m.city))];
const sorted = sortGreek(cities);

sorted.forEach(city => {
  const opt = document.createElement("option");
  opt.value = city;
  opt.textContent = city;
  select.appendChild(opt);
});
}

/* initial load */
loadAllCities(citySelect);

/* LOAD REGIONS FROM MUNICIPALITIES */

const regions = [...new Set(greekMunicipalities.map(m => m.region))];

regions.forEach(region => {

const opt=document.createElement("option");

opt.value=region;

opt.textContent=region;

regionSelect.appendChild(opt);

});

/* REGION FILTER */
regionSelect.addEventListener("change",function(){

prefSelect.innerHTML='<option value="">Όλοι οι Νομοί</option>';

const region=this.value;

const prefs=[...new Set(
greekMunicipalities
.filter(m=>!region || m.region===region)
.map(m=>m.prefecture)
)];

prefs.forEach(p=>{
const opt=document.createElement("option");
opt.textContent=p;
prefSelect.appendChild(opt);
});

/* 🔥 UPDATE CITIES */
if(!region){
  loadAllCities(citySelect);
}else{
  const filtered = greekMunicipalities.filter(m => m.region === region);

  citySelect.innerHTML = '<option value="">🔄 Όλες οι Πόλεις</option>';

  const cities = [...new Set(filtered.map(m => m.city))];
const sorted = sortGreek(cities);

sorted.forEach(city=>{
  const opt=document.createElement("option");
  opt.value=city;
  opt.textContent=city;
  citySelect.appendChild(opt);
});
}

});

/* PREF FILTER */

prefSelect.addEventListener("change", function(){

  const pref = this.value;

  citySelect.innerHTML = '<option value="">🔄 Όλες οι Πόλεις</option>';

  // 🔥 ONLY filter by prefecture (Nomos)
  const filtered = greekMunicipalities.filter(m =>
    !pref || m.prefecture === pref
  );

  const cities = [...new Set(filtered.map(m => m.city))];
const sorted = sortGreek(cities);

sorted.forEach(city=>{
  const opt = document.createElement("option");
  opt.value = city;
  opt.textContent = city;
  citySelect.appendChild(opt);
});

});

/* CITY → MAP */

/* CITY → AUTO-FILL + RESET + MAP */

citySelect.addEventListener("change", async function(){

  const city = this.value;

  /* 🔄 RESET */
  if (!city) {

    regionSelect.value = "";
    prefSelect.innerHTML = '<option value="">Όλοι οι Νομοί</option>';

    loadAllCities(citySelect);

    return;
  }

  /* 🔍 FIND CITY */
  const match = greekMunicipalities.find(m => m.city === city);

  if (match) {

    // ✅ SET REGION (without triggering wrong filtering)
    regionSelect.value = match.region;

    // ✅ LOAD prefectures for that region
    prefSelect.innerHTML = '<option value="">Όλοι οι Νομοί</option>';

    const prefs = [...new Set(
      greekMunicipalities
        .filter(m => m.region === match.region)
        .map(m => m.prefecture)
    )];

    prefs.forEach(p => {
      const opt = document.createElement("option");
      opt.value = p;
      opt.textContent = p;
      prefSelect.appendChild(opt);
    });

    // ✅ SET PREFECTURE
    prefSelect.value = match.prefecture;

    // 🔥 CRITICAL FIX:
    // 👉 FILTER by BOTH region AND prefecture
    citySelect.innerHTML = '<option value="">🔄 Όλες οι Πόλεις</option>';

    const filtered = greekMunicipalities.filter(m =>
      m.region === match.region &&
      m.prefecture === match.prefecture
    );

    const cities = [...new Set(filtered.map(m => m.city))];
    const sorted = sortGreek(cities);

    sorted.forEach(city => {
      const opt = document.createElement("option");
      opt.value = city;
      opt.textContent = city;
      citySelect.appendChild(opt);
    });

    // ✅ RESELECT CITY
    citySelect.value = city;
  }

  /* 🗺 MAP (unchanged) */
  const res = await fetch(
    `https://nominatim.openstreetmap.org/search?format=json&countrycodes=gr&q=${city}`
  );

  const data = await res.json();

  if(data.length){

    const lat = data[0].lat;
    const lon = data[0].lon;

    map.setView([lat,lon],11);

    if(marker) map.removeLayer(marker);

    marker = L.marker([lat,lon]).addTo(map);
  }

});

toggleMode(index);
serviceIndex++;

}

/* REMOVE CARD */

function removeLastServiceCard(){

const container=document.getElementById("servicesContainer");

const cards=container.querySelectorAll(".card");

if(cards.length>1){

cards[cards.length-1].remove();

serviceIndex--;

}else{

alert("Πρέπει να υπάρχει τουλάχιστον μία πόλη.");

}

}

document.addEventListener("DOMContentLoaded",function(){

addServiceCard();



});


function toggleMode(index) {
  const mode = document.getElementById(`mode-${index}`).value;

  const rangeContainer = document.getElementById(`range-container-${index}`);
  const specificContainer = document.getElementById(`specific-container-${index}`);

  const dayFrom = document.getElementById(`day-from-${index}`);
  const dayTo = document.getElementById(`day-to-${index}`);
  const checkboxes = document.querySelectorAll(`.day-checkbox-${index}`);

  if (mode === 'range') {

    rangeContainer.style.display = 'flex';
    specificContainer.style.display = 'none';

    // ENABLE range
    dayFrom.disabled = false;
    dayTo.disabled = false;

    // DISABLE specific
    checkboxes.forEach(cb => {
      cb.checked = false;
      cb.disabled = true;
    });

  } else {

    rangeContainer.style.display = 'none';
    specificContainer.style.display = 'flex';

    // DISABLE range
    dayFrom.disabled = true;
    dayTo.disabled = true;

    // ENABLE specific
    checkboxes.forEach(cb => cb.disabled = false);
  }
}




const weekdays = {
  "Δευτέρα": 1,
  "Τρίτη": 2,
  "Τετάρτη": 3,
  "Πέμπτη": 4,
  "Παρασκευή": 5,
  "Σάββατο": 6,
  "Κυριακή": 7
};

document.querySelector('form').addEventListener('submit', function (e) {
  const cards = document.querySelectorAll('#servicesContainer .card');
  let valid = true;

  cards.forEach((card, idx) => {
    const mode = card.querySelector(`#mode-${idx}`).value;
    const dayFrom = card.querySelector(`#day-from-${idx}`);
    const dayTo = card.querySelector(`#day-to-${idx}`);
    const checkboxes = card.querySelectorAll(`.day-checkbox-${idx}`);
    const timeFrom = card.querySelector(`#from-${idx}`).value;
    const timeTo = card.querySelector(`#to-${idx}`).value;

    let availability = "";

    if (mode === 'range') {
      // Check empty or same day
      if (!dayFrom.value || !dayTo.value || dayFrom.value === dayTo.value) {
        availability = "";
      } else if (weekdays[dayFrom.value] > weekdays[dayTo.value]) {
        // Check order: Από must be earlier than Έως
        availability = "";
      } else {
        availability = `${dayFrom.value}–${dayTo.value}`;
      }
    } else {
      // Specific days: require at least one checkbox
      const daysChecked = Array.from(checkboxes)
        .filter(cb => cb.checked)
        .map(cb => cb.value);
      if (daysChecked.length === 0) {
        availability = "";
      } else {
        availability = daysChecked.join(", ");
      }
    }

    // Time validation: require both filled and From < To
    if (!timeFrom || !timeTo || timeFrom >= timeTo) {
      availability = "";
    } else if (availability) {
      availability += ` (${timeFrom}-${timeTo})`;
    }

    // Set hidden input
    const hidden = card.querySelector(`#diath-${idx}`);
    hidden.value = availability;

    // Highlight invalid cards
    if (!availability || availability.trim() === "") {
      valid = false;
      card.querySelector(`#mode-${idx}`).classList.add('is-invalid');
    } else {
      card.querySelector(`#mode-${idx}`).classList.remove('is-invalid');
    }

  });

  if (!valid) {
    e.preventDefault();
    alert("Παρακαλώ συμπληρώστε σωστά τη Διαθεσιμότητα: ημέρες σε σωστή σειρά και ώρες για όλες τις πόλεις!");
    const firstInvalid = document.querySelector('.is-invalid');
    if (firstInvalid) firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
});


function generateTimeOptions() {
  let options = '<option value="">--:--</option>';

  for (let h = 0; h < 24; h++) {
    for (let m of [0, 30]) {
      const hh = String(h).padStart(2, '0');
      const mm = String(m).padStart(2, '0');
      options += `<option value="${hh}:${mm}">${hh}:${mm}</option>`;
    }
  }

  return options;
}

</script>