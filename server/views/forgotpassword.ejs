<%- include("partials/header.ejs") %>

<div class="container my-5 d-flex justify-content-center align-items-center min-vh-80">
  <div class="card shadow-lg rounded-4 p-4 w-100" style="max-width: 400px; background-color: #fefdf9;">

<div class="text-center mb-4">
  <h4 class="fw-bold">
    <i class="bi bi-key-fill me-2"></i>
    Επαναφορά Κωδικού
  </h4>

  <p class="text-muted">
   Εισάγετε το email σας και ορίστε έναν νέο κωδικό πρόσβασης.
  </p>
</div>

<% if (locals.message) { %>
  <div class="alert alert-info text-center">
    <%= message %>
  </div>
<% } %>

<form action="/forgotpassword" method="POST" class="row g-3">

  <!-- Email -->
  <div class="col-12">
    <label for="email" class="form-label">Email</label>
    <input type="email"
           id="email"
           name="email"
           class="form-control rounded-pill"
           placeholder="example@domain.com"
           required>
  </div>

  <!-- New Password -->
  <div class="col-12 position-relative">
    <label for="password" class="form-label">Νέος Κωδικός</label>
    <input type="password"
           id="password"
           name="password"
           class="form-control rounded-pill"
           minlength="7"
           placeholder="Τουλάχιστον 7 χαρακτήρες"
           required>

    <i class="bi bi-eye-fill position-absolute"
       id="togglePassword"
       style="top:38px; right:15px; cursor:pointer;"></i>
  </div>

  <!-- Confirm Password -->
  <div class="col-12 position-relative">
    <label for="confirmPassword" class="form-label">Επιβεβαίωση Κωδικού</label>
    <input type="password"
           id="confirmPassword"
           name="confirmPassword"
           class="form-control rounded-pill"
           minlength="7"
           placeholder="Επαναλάβετε τον κωδικό"
           required>

    <i class="bi bi-eye-fill position-absolute"
       id="toggleConfirm"
       style="top:38px; right:15px; cursor:pointer;"></i>
  </div>

  <!-- Submit -->
  <div class="col-12 mt-3">
    <button type="submit"
            class="btn btn-success w-100 rounded-pill py-2">
      <i class="bi bi-check-circle-fill me-2"></i>
      Αποστολή Κωδικού
    </button>
  </div>

  <!-- Back -->
  <div class="text-center mt-3">
    <a href="/login" class="text-decoration-none">
      <i class="bi bi-arrow-left"></i>
      Επιστροφή στη Σύνδεση
    </a>
  </div>

</form>

  </div>
</div>

<%- include("partials/footer.ejs") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>

// Toggle password
const togglePassword = document.getElementById("togglePassword");
const password = document.getElementById("password");

togglePassword.addEventListener("click", () => {

  const type = password.type === "password" ? "text" : "password";
  password.type = type;

  togglePassword.classList.toggle("bi-eye-fill");
  togglePassword.classList.toggle("bi-eye-slash-fill");

});

// Toggle confirm password
const toggleConfirm = document.getElementById("toggleConfirm");
const confirmPassword = document.getElementById("confirmPassword");

toggleConfirm.addEventListener("click", () => {

  const type = confirmPassword.type === "password" ? "text" : "password";
  confirmPassword.type = type;

  toggleConfirm.classList.toggle("bi-eye-fill");
  toggleConfirm.classList.toggle("bi-eye-slash-fill");

});

</script>