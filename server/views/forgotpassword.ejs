<%- include("partials/header.ejs") %> 

<div class="container my-5 d-flex justify-content-center align-items-center min-vh-80">
  <div class="card shadow-lg rounded-4 p-4 w-100" style="max-width: 400px; background-color: #fefdf9;">

    <div class="text-center mb-4">
      <h4 class="fw-bold">
        <i class="bi bi-key-fill me-2"></i>
        Επαναφορά Κωδικού
      </h4>

      <p class="text-muted">
        Εισάγετε το email σας για να σας στείλουμε link επαναφοράς.
      </p>
    </div>

    <% if (locals.message) { %>
      <div class="alert alert-info text-center">
        <%= message %>
      </div>
    <% } %>

    <form action="/forgotpassword" method="POST" class="row g-3">

      <!-- Email -->
      <div class="col-12">
        <label for="email" class="form-label">Email</label>
        <input type="email"
               id="email"
               name="email"
               class="form-control rounded-pill"
               placeholder="example@domain.com"
               required>
      </div>

      <!-- Submit -->
      <div class="col-12 mt-3">
        <button type="submit"
                class="btn btn-success w-100 rounded-pill py-2">
          <i class="bi bi-envelope-fill me-2"></i>
          Αποστολή Email
        </button>
      </div>

      <!-- Back -->
      <div class="text-center mt-3">
        <a href="/login" class="text-decoration-none">
          <i class="bi bi-arrow-left"></i>
          Επιστροφή στη Σύνδεση
        </a>
      </div>

    </form>

  </div>
</div>

<%- include("partials/footer.ejs") %>