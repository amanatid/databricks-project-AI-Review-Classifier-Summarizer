<%- include("partials/header.ejs") %> 

<div class="container my-5 d-flex justify-content-center align-items-center min-vh-80">
  <div class="card shadow-lg rounded-4 p-4 w-100" style="max-width: 400px; background-color: #fefdf9;">

    <div class="text-center mb-4">
      <h4 class="fw-bold">
        <i class="bi bi-key-fill me-2"></i>
        Επαναφορά Κωδικού
      </h4>

      <p class="text-muted">
           Εισάγετε το όνομα χρήστη που χρησιμοποιείτε για σύνδεση 
          (email ή κινητό τηλέφωνο).
      </p>
    </div>

    <% if (locals.message) { %>
      <div class="alert alert-info text-center">
        <%= message %>
      </div>
    <% } %>

    <form action="/forgotpassword" method="POST" class="row g-3">

      <!-- Email -->
     <div class="col-12">
        <label for="identifier" class="form-label">Όνομα Χρήστη</label>
        <input type="text"
              id="identifier"
              name="identifier"
              class="form-control rounded-pill"
              placeholder="example@domain.com ή 69XXXXXXXX">
    </div>

    <div class="col-12" id="email-container" style="display:none;">
        <label for="email" class="form-label">Email (Υποχρεωτικό για κινητό)</label>
        <input type="email"
              id="email"
              name="email"
              class="form-control rounded-pill"
              placeholder="example@domain.com">
    </div>

      <!-- Submit -->
      <div class="col-12 mt-3">
        <button type="submit"
                class="btn btn-success w-100 rounded-pill py-2">
          <i class="bi bi-envelope-fill me-2"></i>
          Αποστολή Email
        </button>
      </div>

      <!-- Back -->
      <div class="text-center mt-3">
        <a href="/login" class="text-decoration-none">
          <i class="bi bi-arrow-left"></i>
          Επιστροφή στη Σύνδεση
        </a>
      </div>

    </form>

  </div>
</div>

<%- include("partials/footer.ejs") %>

<script>
const identifier = document.getElementById("identifier");
const emailContainer = document.getElementById("email-container");
const emailInput = document.getElementById("email");
const form = document.querySelector("form");

function startsWith69(value) {
  return value.startsWith("69");
}

identifier.addEventListener("input", () => {
  const value = identifier.value.trim();

  if (startsWith69(value)) {
    emailContainer.style.display = "block";
    emailInput.setAttribute("required", "true");
  } else {
    emailContainer.style.display = "none";
    emailInput.removeAttribute("required");
    emailInput.value = "";
  }
});

form.addEventListener("submit", function(e) {
  const value = identifier.value.trim();

  if (!value) {
    e.preventDefault();
    alert("Συμπληρώστε email ή κινητό.");
    return;
  }

  // Optional: strict mobile validation on submit
  if (/^69\d{8}$/.test(value) && !emailInput.value.trim()) {
    e.preventDefault();
    alert("Για κινητό απαιτείται και email.");
  }
});
</script>