<!DOCTYPE html>
<html lang="el">
<head>
   <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Βρες τον Μάστορα σου!</title>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="./styles/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

</head>
<body>
  

<!-- ✅ Navbar -->
<!-- ✅ Navbar -->
<nav class="navbar navbar-expand-lg shadow-sm bg-white">
  <div class="container">

    <!-- Logo -->
    <a class="navbar-brand d-flex align-items-center" href="#">
      <span class="ms-2 fw-bold">Βρες τον Μάστορα σου!</span>
    </a>

    <!-- Mobile toggle -->
    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Menu -->
    <div class="collapse navbar-collapse" id="navbarNav">

      <ul class="navbar-nav ms-auto align-items-center flex-nowrap nav-scroll">

        <li class="nav-item">
          <a class="nav-link" href="/">Αρχική</a>
        </li>

        <% if (!user) { %>
          <li class="nav-item">
            <a class="nav-link" href="/login">Σύνδεση</a>
          </li>
        <% } %>

        <% if (user) { %>

          <li class="nav-item">
            <span class="nav-link text-nowrap">
              👋 <%= user.username %>
            </span>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/mycards">Οι Κάρτες Μου</a>
          </li>

          <li class="nav-item">
            <a class="nav-link text-nowrap" href="/profile">
              <i class="bi bi-person-circle me-1"></i>
              Προφίλ
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/logout">Έξοδος</a>
          </li>

          <li class="nav-item ms-2">
            <a class="btn btn-success rounded-pill px-3 text-nowrap"
               href="/technician">
              Γίνε Συνεργάτης
            </a>
          </li>

        <% } %>

        <% if (!user) { %>
          <li class="nav-item ms-2">
            <a class="btn btn-success rounded-pill px-3 text-nowrap"
               href="/become-technician">
              Γίνε Συνεργάτης
            </a>
          </li>
        <% } %>

        <li class="nav-item ms-2">
          <a class="nav-link" href="/simvoules">Συμβουλές</a>
        </li>

        <li class="nav-item">
          <a class="nav-link" href="/epikoinwnia">Επικοινωνία</a>
        </li>

      </ul>
    </div>

  </div>
</nav>
