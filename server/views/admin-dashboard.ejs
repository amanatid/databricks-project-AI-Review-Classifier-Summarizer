<%- include("partials/header.ejs") %>

<link rel="stylesheet"
 href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-5">

  <div class="text-center mb-4">
    <h3 class="fw-bold">
      <i class="bi bi-shield-lock-fill"></i>
      Admin Dashboard
    </h3>
    <p class="text-muted">Διαχείριση όλων των τεχνικών</p>
  </div>

  <hr class="my-4">


  <div class="card shadow-sm p-3 mb-4">
  <div class="row g-3">

    <!-- ACCOUNT -->
    <div class="col-md-3">
      <label class="form-label">Λογαριασμός</label>
      <select id="filter-account" class="form-select">
        <option value="">Όλα</option>
        <option value="yes">Με λογαριασμό</option>
        <option value="no">Χωρίς λογαριασμό</option>
      </select>
    </div>

    <!-- PERIFEREIA -->
    <div class="col-md-3">
      <label class="form-label">Περιφέρεια</label>
      <select id="filter-region" class="form-select">
        <option value="">Όλες</option>
      </select>
    </div>

    <!-- NOMOS -->
    <div class="col-md-3">
      <label class="form-label">Νομός</label>
      <select id="filter-pref" class="form-select">
        <option value="">Όλοι</option>
      </select>
    </div>

    <!-- POLI -->
    <div class="col-md-3">
      <label class="form-label">Πόλη</label>
      <select id="filter-city" class="form-select">
        <option value="">Όλες</option>
      </select>
    </div>

    
    <!-- BUTTON -->
    <div class="col-12">
  <button id="applyFilters" class="btn btn-primary w-100 py-2">
    🔍 Εμφάνιση
  </button>
</div>

  </div>
</div>



  <div class="row g-4">

  <% if (cards && cards.length > 0) { %>

    <% cards.forEach(function(item) { %>

      <div class="<%= cards.length === 1 ? 'col-12' : 'col-md-6' %> card-item"
            data-account="<%= item.texnitesUsers?.username ? 'yes' : 'no' %>"
            data-region="<%= item.Perifereia || '' %>"
            data-pref="<%= item.Nomos || '' %>"
            data-city="<%= item.Poli || '' %>">

        <div class="card border-0 shadow-sm h-100">
          <div class="card-body p-4 d-flex flex-column">

            <p class="text-muted small mb-2">
              👤 <b><%= item.texnitesUsers?.username %></b>
            </p>

            <div class="text-center mb-3">
              <h4 class="fw-bold">
                <%= item.Onoma %> <%= item.Epitheto %>
              </h4>
            </div>

            <p class="mb-2">
              <i class="bi bi-award-fill me-2 text-success"></i>
              <strong>Ειδικότητα:</strong>
              <span class="badge bg-success">
                <%= item.Eidikotita %>
              </span>
            </p>

          <% if (item.Epimerous1) { %>
            <% item.Epimerous1.split(',').forEach(function(word) { %>
              <p class="text-muted small mb-1">
                ✔️ <%= word.trim() %>
              </p>
            <% }) %>
          <% } %>

            <p><i class="bi bi-tools me-2"></i><strong>Πρόσθετες:</strong> <%= item.Prosthetes %></p>
            <p><i class="bi bi-cash-coin text-success me-2"></i><strong>Τιμή:</strong> €<%= item.Timi %></p>

            <p class="mb-1">
              <i class="bi bi-geo-alt-fill me-2" style="color: #85c1f3;"></i>
              <strong>Πόλη:</strong><%= item.Poli %>
            </p>

            <p>
              <i class="bi bi-calendar-check-fill text-info me-2"></i>
              <strong>Διαθεσιμότητα:</strong>
              <%= item.Diathesimotita %>
            </p>

            <a href="tel:<%= item.Phone %>"
               class="btn phone-button w-100 mb-2 rounded-pill">
              <i class="bi bi-telephone-fill me-2"></i> <%= item.Phone %>
            </a>

           <div class="d-flex justify-content-center gap-2 mt-auto">

              <button class="btn btn-outline-primary btn-sm"
                      data-bs-toggle="modal"
                      data-bs-target="#editModal<%= item.id %>">
                <i class="bi bi-pencil-square"></i> Επεξεργασία
              </button>

              <form action="/admin/delete/<%= item.id %>?_method=DELETE"
                    method="POST"
                    onsubmit="return confirm('Διαγραφή κάρτας;')">

                <button class="btn btn-outline-danger btn-sm">
                  <i class="bi bi-trash"></i> Διαγραφή
                </button>

              </form>

            </div>

          </div>
        </div>

      </div>

    <% }) %>

  <% } else { %>
    <p class="text-center text-muted">Δεν υπάρχουν δεδομένα.</p>
  <% } %>

  </div>
</div>

<!-- ================= MODALS ================= -->

<% if (cards && cards.length > 0) { %>
  <% cards.forEach(function(item) { %>

<div class="modal fade"
     id="editModal<%= item.id %>"
     tabindex="-1"
     aria-hidden="true">

  <div class="modal-dialog">
    <div class="modal-content rounded-4">

      <form action="/admin/edit/<%= item.id %>" method="POST">

        <div class="modal-header">
          <h5 class="modal-title">Επεξεργασία</h5>
          <button type="button"
                  class="btn-close"
                  data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
           
            
            <input  type="hidden" class="form-control"
                   name="idtexnitesusers" value="<%= item.texnitesUsers?.id %>">
         

            <div class="mb-3">
            <label class="form-label">👤</label>
            <input type="text" class="form-control username-input"
                    name="username"
                    value="<%= item.texnitesUsers?.username %>"
                    id="username-<%= item.id %>">
            </div>

            <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="text" class="form-control password-input"
                    name="password"
                    value=""
                    minlength="7"
                    id="password-<%= item.id %>"
                    placeholder="<%= item.texnitesUsers?.username ? 
                                'Άφησε κενό αν δεν θέλεις αλλαγή' : 
                                'Εισάγετε νέο password (τουλάχιστον 7 χαρακτήρες)' %>">
            </div>

            <script>
            document.addEventListener("DOMContentLoaded", () => {
            const usernameInput<%= item.id %> = document.getElementById('username-<%= item.id %>');
            const passwordInput<%= item.id %> = document.getElementById('password-<%= item.id %>');

            // Initially: if username exists, password is not required
            if (usernameInput<%= item.id %>.value) {
                passwordInput<%= item.id %>.required = false;
            }

            // Dynamically set required if username typed in
            usernameInput<%= item.id %>.addEventListener('input', () => {
                if (!<%= item.texnitesUsers?.username ? 'true' : 'false' %>) {
                // Only apply if the initial username was empty
                passwordInput<%= item.id %>.required = usernameInput<%= item.id %>.value.trim().length > 0;
                }
            });
            });
            </script>
          <div class="mb-3">
            <label class="form-label">Όνομα</label>
            <input type="text" class="form-control"
                   name="Onoma" value="<%= item.Onoma %>">
          </div>

          <div class="mb-3">
            <label class="form-label">Επώνυμο</label>
            <input type="text" class="form-control"
                   name="Epitheto" value="<%= item.Epitheto %>">
          </div>

          <!-- Ειδικότητα -->
          <div class="mb-3">
            <label class="form-label">Ειδικότητα</label>

            <select class="form-select eidikotita-select"
                    name="Eidikotites"
                    data-id="<%= item.id %>" required>

              <% Object.keys(professionMap).forEach(function(cat){ %>
                <option value="<%= cat %>"
                  <%= item.Eidikotites === cat ? 'selected' : '' %>>
                  <%= cat %>
                </option>
              <% }) %>

            </select>
          </div>

          <!-- ✅ DYNAMIC EPIMEROUS -->
          <div class="mb-3">
            <label class="form-label">Επιμέρους</label>
            <div id="epimerous-container-<%= item.id %>"></div>
          </div>

          <!-- PERIFEREIA -->
          <div class="mb-3">
            <label class="form-label">Περιφέρεια</label>
            <select class="form-select region-select"
                    name="Perifereia"
                    data-id="<%= item.id %>">
              <option value="<%= item.Perifereia %>">
                <%= item.Perifereia || "Επιλέξτε Περιφέρεια" %>
              </option>
            </select>
          </div>

          <!-- NOMOS -->
          <div class="mb-3">
            <label class="form-label">Νομός</label>
            <select class="form-select pref-select"
                    name="Nomos"
                    data-id="<%= item.id %>">
              <option value="<%= item.Nomos %>">
                <%= item.Nomos || "Επιλέξτε Νομό" %>
              </option>
            </select>
          </div>

          <!-- CITY -->
          <div class="mb-3">
            <label class="form-label">Πόλη</label>
            <select class="form-select city-select"
                    name="Poli"
                    data-id="<%= item.id %>">
              <option value="<%= item.Poli %>">
                <%= item.Poli || "Επιλέξτε Πόλη" %>
              </option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Πρόσθετες</label>
            <textarea class="form-control"
                      name="Prosthetes"><%= item.Prosthetes %></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label">Τιμή (€)</label>
            <input type="number" class="form-control"
                   name="Timi" value="<%= item.Timi %>">
          </div>

          <div class="mb-3">
            <label class="form-label">Διαθεσιμότητα</label>
            <input type="text" class="form-control"
                   name="Diathesimotita"
                   value="<%= item.Diathesimotita %>">
          </div>

          <div class="mb-3">
            <label class="form-label">Τηλέφωνο</label>
            <input type="text" class="form-control"
                   name="Phone" value="<%= item.Phone %>">
          </div>

        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary"
                  data-bs-dismiss="modal">Ακύρωση</button>
          <button type="submit" class="btn btn-primary">
            Αποθήκευση
          </button>
        </div>

      </form>

    </div>
  </div>
</div>

  <% }) %>
<% } %>

<%- include("partials/footer.ejs") %>

<script src="/data/greekMunicipalities.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
const optionsMap = <%- JSON.stringify(optionsMap) %>;
const professionMap = <%- JSON.stringify(professionMap) %>;

// ================= EPIMEROUS =================
function generateEpimerous(category, id, selected = []) {
  const container = document.getElementById(`epimerous-container-${id}`);
  container.innerHTML = "";

  if (!optionsMap[category]) return;

  selected = selected.map(s => s.trim().toLowerCase());

  optionsMap[category].forEach((service, i) => {
    const checked = selected.includes(service.toLowerCase()) ? "checked" : "";

    container.innerHTML += `
      <div class="form-check">
        <input class="form-check-input"
               type="checkbox"
               name="Epimerous1[]"
               value="${service}"
               id="ep-${id}-${i}"
               ${checked}>
        <label class="form-check-label" for="ep-${id}-${i}">
          ${service}
        </label>
      </div>
    `;
  });
}

// ================= STORE ORIGINAL EPIMEROUS =================
const storedEpimerous = {};

document.addEventListener("DOMContentLoaded", () => {

  // INIT EPIMEROUS
  <% cards.forEach(function(item){ %>
    storedEpimerous["<%= item.id %>"] =
      "<%= item.Epimerous1 || '' %>"
        .split(",")
        .map(s => s.trim())
        .filter(Boolean);

    generateEpimerous(
      "<%= item.Eidikotites %>",
      <%= item.id %>,
      storedEpimerous["<%= item.id %>"]
    );
  <% }) %>

  // CHANGE CATEGORY
  document.querySelectorAll(".eidikotita-select").forEach(select => {
    select.addEventListener("change", function () {
      const id = this.dataset.id;
      const selectedCategory = this.value;

      // find original category for this id
      const originalCategories = <%- JSON.stringify(cards.map(c => ({ id: c.id, cat: c.Eidikotites }))) %>;
      const original = originalCategories.find(x => x.id == id)?.cat;

      // restore previously selected boxes if user selects the original category
      if (selectedCategory === original) {
        generateEpimerous(selectedCategory, id, storedEpimerous[id]);
      } else {
        generateEpimerous(selectedCategory, id, []);
      }
    });
  });

});



// ================= FILTER LOGIC =================

document.addEventListener("DOMContentLoaded", () => {

  const regionSelect = document.getElementById("filter-region");
  const prefSelect = document.getElementById("filter-pref");
  const citySelect = document.getElementById("filter-city");

  // populate regions
  const regions = [...new Set(greekMunicipalities.map(m => m.region))];
  regions.forEach(r => {
    const opt = document.createElement("option");
    opt.value = r;
    opt.textContent = r;
    regionSelect.appendChild(opt);
  });

  // region change → prefectures
  regionSelect.addEventListener("change", () => {
    prefSelect.innerHTML = '<option value="">Όλοι</option>';

    const prefs = [...new Set(
      greekMunicipalities
        .filter(m => !regionSelect.value || m.region === regionSelect.value)
        .map(m => m.prefecture)
    )];

    prefs.forEach(p => {
      const opt = document.createElement("option");
      opt.value = p;
      opt.textContent = p;
      prefSelect.appendChild(opt);
    });

    citySelect.innerHTML = '<option value="">Όλες</option>';
  });

  // prefecture change → cities
  prefSelect.addEventListener("change", () => {
    citySelect.innerHTML = '<option value="">Όλες</option>';

    const cities = greekMunicipalities.filter(m =>
      (!regionSelect.value || m.region === regionSelect.value) &&
      (!prefSelect.value || m.prefecture === prefSelect.value)
    );

    cities.forEach(c => {
      const opt = document.createElement("option");
      opt.value = c.city;
      opt.textContent = c.city;
      citySelect.appendChild(opt);
    });
  });

  // APPLY FILTERS
  document.getElementById("applyFilters").addEventListener("click", () => {

    const account = document.getElementById("filter-account").value;
    const region = regionSelect.value;
    const pref = prefSelect.value;
    const city = citySelect.value;

    document.querySelectorAll(".card-item").forEach(card => {

      const matchAccount = !account || card.dataset.account === account;
      const matchRegion = !region || card.dataset.region === region;
      const matchPref = !pref || card.dataset.pref === pref;
      const matchCity = !city || card.dataset.city === city;

      if (matchAccount && matchRegion && matchPref && matchCity) {
        card.style.display = "block";
      } else {
        card.style.display = "none";
      }

    });

  });

});
</script>