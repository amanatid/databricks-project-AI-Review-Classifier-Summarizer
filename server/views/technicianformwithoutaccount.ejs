<%- include("partials/header.ejs") %>

<link rel="stylesheet"
 href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<% if (locals.submitbutton) { %> 
<div class="alert alert-warning alert-dismissible show" role="alert">
  <%= message %>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div> 
<% } %>      

<div class="container my-5 px-2 d-flex justify-content-center align-items-center min-vh-100">

<% if (!locals.submitbutton) { %>

<div class="card shadow-lg rounded-4 p-4 border-0 w-100"
     style="max-width: 800px; background-color: #fefdf9;">

<form class="row g-4" action="/technicianwithoutaccount" method="POST">

<div class="text-center mb-4">
<h3 class="fw-bold">
<i class="bi bi-person-badge"></i>
Προσθήκη Τεχνίτη
</h3>
<p class="text-muted">Συμπληρώστε τα στοιχεία για νέο τεχνίτη.</p>
</div>

<div class="mb-3">
<label class="form-label">Όνομα</label>
<input type="text" class="form-control rounded-pill" name="Onoma" required>
</div>

<div class="mb-4">
<label class="form-label">Επίθετο</label>
<input type="text" class="form-control rounded-pill" name="Epitheto" required>
</div>

<!-- SPECIALTY MOVED HERE -->

<div class="mb-3">
<label class="form-label">Επιλέξτε Ειδικότητα</label>

<select class="form-select rounded-pill"
onchange="generateSubOptions(this.value)"
name="Eidikotites" required>

<option value="">🛠 Επιλέξτε Ειδικότητα</option>

   <% Object.keys(optionsMap).forEach( service => { %>
       <option><%= service %></option>
   <% }) %>
</select>

</div>

<div id="additional-global"></div>

<hr class="my-4">

<div id="servicesContainer"></div>

<div class="text-center mt-4">

<button type="button"
class="btn btn-success rounded-pill px-4 shadow-sm me-3"
onclick="addServiceCard()">

<i class="bi bi-plus-circle"></i>
Προσθήκη Πόλης

</button>

<button type="button"
class="btn btn-outline-danger rounded-pill px-4 shadow-sm"
onclick="removeLastServiceCard()">

<i class="bi bi-trash"></i>
Διαγραφή Πόλης

</button>

</div>

<button type="submit"
class="btn btn-success w-100 rounded-pill py-2 mt-4 shadow">
Υποβολή Τεχνίτη
</button>

</form>
</div>
<% } %>
</div>

<%- include("partials/footer.ejs") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/data/greekMunicipalities.js"></script>


<script>

const cities = greekMunicipalities.filter(m => m.region === "Αττικής");
const optionsMap = <%- JSON.stringify(optionsMap) %>;
//console.log(cities);
</script>
<script>

let serviceIndex = 0;

/* ---------------- MUNICIPALITIES ---------------- */

/* ---------------- SERVICES ---------------- */


/* ---------------- GLOBAL SUB OPTIONS ---------------- */

function generateSubOptions(category){

const container=document.getElementById("additional-global");

container.innerHTML="";

const sub=optionsMap[category];

if(!sub) return;

sub.forEach((item,i)=>{

container.innerHTML+=`

<div class="form-check">

<input class="form-check-input"
type="checkbox"
name="Epimerous[]"
value="${item}"
id="sub-${i}">

<label class="form-check-label" for="sub-${i}">
${item}
</label>

</div>

`;

});

}

/* ---------------- ADD CITY CARD ---------------- */

function addServiceCard(){

const container=document.getElementById("servicesContainer");

const index=serviceIndex;

const card=document.createElement("div");

card.className="card shadow-sm rounded-4 p-4 mb-4 border-0";

card.innerHTML=`

<div class="row g-3">

<div class="col-12">

<label class="form-label">Περιφέρεια</label>

<select id="region-${index}" class="form-select mb-2" name="services[${index}][Perifereia]" required>

<option value="">Όλες</option>


</select>

<label class="form-label">Νομός</label>

<select id="pref-${index}" class="form-select mb-3"
name="services[${index}][Nomos]" required
>

<option value="">Όλοι</option>

</select>


<label class="form-label">Επιλογή Πόλης</label>

<select class="form-select rounded-pill"
id="city-${index}"
name="services[${index}][Poli]" required>

<option value="">Επιλέξτε Πόλη</option>

</select>

<div id="map-${index}"
style="height:300px;border-radius:1rem;margin-top:10px;"></div>

</div>

<div class="col-12">

<label class="form-label">Πρόσθετες Εργασίες</label>


<input type="text"
class="form-control rounded-pill"
name="services[${index}][Prosthetes]" required>

</div>


<div class="col-12">

<label class="form-label">Ενδεικτική  Τιμή (€)</label>

<input type="number"
class="form-control rounded-pill"
name="services[${index}][Timi]">

</div>

<div class="col-12">

<label class="form-label">Διαθεσιμότητα</label>

<input type="text"
class="form-control rounded-pill"
name="services[${index}][Diathesimotita]" required>

</div>

<div class="col-12">

<label class="form-label">Τηλέφωνο</label>

<input type="tel"
class="form-control rounded-pill"
name="services[${index}][Phone]" required>

</div>

</div>

`;

container.appendChild(card);

/* ---------------- MAP ---------------- */

const map=L.map(`map-${index}`).setView([39.0742,21.8243],7);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
attribution:'© OpenStreetMap'
}).addTo(map);

let marker;

/* ---------------- SELECT ELEMENTS ---------------- */

const regionSelect=document.getElementById(`region-${index}`);

const prefSelect=document.getElementById(`pref-${index}`);

const citySelect=document.getElementById(`city-${index}`);

/* LOAD REGIONS FROM MUNICIPALITIES */

const regions = [...new Set(greekMunicipalities.map(m => m.region))];

regions.forEach(region => {

const opt=document.createElement("option");

opt.value=region;

opt.textContent=region;

regionSelect.appendChild(opt);

});

/* REGION FILTER */

regionSelect.addEventListener("change",function(){

prefSelect.innerHTML='<option value="">Όλοι</option>';

const region=this.value;

const prefs=[...new Set(
greekMunicipalities
.filter(m=>!region || m.region===region)
.map(m=>m.prefecture)
)];

prefs.forEach(p=>{
const opt=document.createElement("option");
opt.textContent=p;
prefSelect.appendChild(opt);
});

});

/* PREF FILTER */

prefSelect.addEventListener("change",function(){

citySelect.innerHTML='<option value="">Επιλέξτε Πόλη</option>';

const region=regionSelect.value;

const pref=this.value;

const cities=greekMunicipalities
.filter(m =>
(!region || m.region===region) &&
(!pref || m.prefecture===pref)
);

cities.forEach(c=>{

const opt=document.createElement("option");

opt.value=c.city;

opt.textContent=c.city;

citySelect.appendChild(opt);

});

});

/* CITY → MAP */

citySelect.addEventListener("change",async function(){

const city=this.value;

if(!city) return;

const res=await fetch(
`https://nominatim.openstreetmap.org/search?format=json&countrycodes=gr&q=${city}`
);

const data=await res.json();

if(data.length){

const lat=data[0].lat;

const lon=data[0].lon;

map.setView([lat,lon],11);

if(marker) map.removeLayer(marker);

marker=L.marker([lat,lon]).addTo(map);

}

});

serviceIndex++;

}

/* REMOVE CARD */

function removeLastServiceCard(){

const container=document.getElementById("servicesContainer");

const cards=container.querySelectorAll(".card");

if(cards.length>1){

cards[cards.length-1].remove();

serviceIndex--;

}else{

alert("Πρέπει να υπάρχει τουλάχιστον μία πόλη.");

}

}

document.addEventListener("DOMContentLoaded",function(){

addServiceCard();

});

</script>